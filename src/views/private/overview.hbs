<div id="current-container" data-location="/private/overview">
    <div class="container">
        <p id="path">Übersicht</p>
    </div>
    <div class="container">
        <header>Übersicht</header>
        <div class="content">
            {{#if entries.length}}
                <table class="table">
                    <thead>
                        <tr>
                            <th>Sport</th>
                            <th>Bestes Ergebnis</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each entries}}
                            <tr>
                                <td>{{name}}</td>
                                <td>
                                    {{#if filled}}
                                        {{score}}{{unitSymbol}}
                                        {{#if @root.teacher}}
                                            ({{student}})
                                        {{/if}}
                                    {{/if}}
                                </td>
                                <td>
                                    <span class="get-button clickable btn-icon icon icon-circle-arrow-right" data-location="/private/sport/{{id}}"></span>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            {{else}}
                <div class="info-message">
                    <p>Es sind keine Sportarten eingetragen.</p>
                    {{#if teacher}}
                        <p>Erstellen Sie einen neuen Eintrag, indem sie in der Fußzeile den ersten Knopf verwenden.</p>
                    {{/if}}
                </div>
            {{/if}}
        </div>
    </div>
</div>