<div id="current-container" data-location="/private/sport/{{sport.id}}">
    <div class="container">
        <p id="path">
            <span class="get-button clickable link hover" data-location="/private/overview">Übersicht</span> / {{sport.name}}
        </p>
    </div>
    <div class="container">
        <header>
            {{sport.name}}
            <span class="get-button right clickable btn-icon icon icon-plus-sign" data-location="/private/new/performance/{{sport.id}}"></span>
        </header>
        <div class="content">
            {{#if entries.length}}
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>{{sport.unit}}</th>
                            <th> </th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each entries}}
                            <tr>
                                <td>{{student.name}}</td>
                                {{#if entry}}
                                    <td>{{score}}{{@root.sport.unitSymbol}}</td>
                                    <td>
                                        <span class="get-button clickable btn-icon icon icon-plus-sign" data-location="/private/new/performance/{{@root.sport.id}}/{{student.id}}"></span>
                                        <span class="get-button clickable btn-icon icon icon-circle-arrow-right" data-location="/private/sport/{{@root.sport.id}}/{{student.id}}"></span>
                                    </td>
                                {{else}}
                                    <td></td>
                                    <td>
                                        <span class="get-button clickable btn-icon icon icon-plus-sign" data-location="/private/new/performance/{{@root.sport.id}}/{{student.id}}"></span>
                                    </td>
                                {{/if}}

                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            {{else}}
                <div class="info-message">
                    <p>Es sind keine Leistungen eingetragen.</p>
                    <p>Erstellen Sie einen neuen Eintrag, indem Sie oben rechts auf den Knopf drücken.</p>
                </div>
            {{/if}}
        </div>
    </div>
</div>