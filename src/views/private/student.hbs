<div id="current-container" data-location="/private/sport/{{sport.id}}/{{student.id}}">
    <div class="container">
        <p id="path">
            <span class="get-button clickable link hover" data-location="/private/overview">Übersicht</span> /
            <span class="get-button clickable link hover" data-location="/private/sport/{{sport.id}}">{{sport.name}}</span> /
            {{student.name.last}} {{student.name.first}}
        </p>
    </div>
    <div class="container">
        <header>
            {{sport.name}}
            {{#if teacher}}
                von {{student.name.first}}
                <span class="get-button right clickable btn-icon icon icon-plus-sign" data-location="/private/new/performance/{{sport.id}}/{{student.id}}"></span>
            {{/if}}
        </header>
        <div class="content">
            <div class="error-message">
                <p class="error-title"></p>
                <p class="error-description"></p>
            </div>

            {{#if entries.length}}
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{sport.unit}}</th>
                            <th>Lehrer</th>
                            {{#if teacher}}
                                <th></th>
                            {{/if}}
                        </tr>
                    </thead>
                    <tbody>
                        {{#each entries}}
                            <tr>
                                <td>{{score}}{{@root.sport.unitSymbol}}</td>
                                <td>{{teacher}}</td>
                                {{#if @root.teacher}}
                                    <td>
                                        <span class="delete-button clickable btn-icon icon icon-remove-sign" data-location="/private/sport/{{@root.sport.id}}/{{@root.student.id}}/{{id}}" data-csrf-token="{{@root.csrfToken}}"></span>
                                    </td>
                                {{/if}}
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            {{else}}
                <div class="info-message">
                    <p>Es sind keine Leistungen eingetragen.</p>
                    {{#if teacher}}
                        <p>Erstellen Sie einen neuen Eintrag, indem Sie oben rechts auf den Knopf drücken.</p>
                    {{/if}}
                </div>
            {{/if}}
        </div>
    </div>
</div>