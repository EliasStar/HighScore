<html lang="" data-theme="light">

<head>
    <title>HighScore</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="/public/img/favicon.ico">
    <link rel="stylesheet" type="text/css" href="/public/css/style.css">
    <script src="/public/js/client.js" defer></script>
    <script src="/public/js/index.js" defer></script>
    <script src="/public/js/container.js" defer></script>
    {{#if teacher}}
    <script src="/public/js/teacher.js" defer></script>
    {{/if}}
</head>

<body>
    <main>
        <div id="loading-container">
            <div class="container">
                <p id="path">Laden...</p>
            </div>
            <div class="container">
                <header>Laden...</header>
                <div class="content">
                    <span class="spin icon icon-refresh"></span>
                </div>
            </div>
        </div>
        <div id="error-container">
            <div class="container">
                <p id="path">
                    <span id="path-error" class="clickable link hover">Übersicht</span> / Fehler
                </p>
            </div>
            <div class="container">
                <header>Fehler</header>
                <div class="content">
                    <div class="error-message">
                        <p class="error-title"></p>
                        <p class="error-description"></p>
                    </div>
                </div>
            </div>
        </div>
        {{> (lookup . 'currentContainer') }}
    </main>
    <footer id="footer">
        <span id="logo" class="clickable hover">
            <img src="/public/img/logo.jpg" alt="Dachsberg Logo" />
            <h1>HighScore</h1>
        </span>


        <span id="options">
            <span>
                {{#if teacher}}
                <label for="gender">Geschlecht:</label>
                <select id="gender" class="input">
                    <option value="A" selected>Alle</option>
                    <option value="W">Mädchen</option>
                    <option value="M">Buben</option>
                </select>

                <span class="right">
                    <label for="class">Klasse:</label>
                    <select id="class" class="input">
                        <option value="ALL" selected>Alle</option>
                        {{#if classes}}
                        {{#each classes}}
                        <option value="{{this}}">{{this}}</option>
                        {{/each}}
                        {{/if}}
                    </select>
                </span>
                {{/if}}
            </span>
        </span>

        <span id="buttons">
            {{#if teacher}}
            <button id="add-button" class="btn-normal clickable" type="button">
                <img src="/public/img/plus.svg" alt="Add">
            </button>
            {{/if}}
            <button id="theme-button" class="btn-normal clickable" type="button">
                <img id="icon-dark" src="/public/img/dark.svg" alt="Switch Theme">
                <img id="icon-light" src="/public/img/light.svg" alt="Switch Theme">
            </button>
            <button id="dropup-button" class="btn-normal clickable" type="button">
                <img src="/public/img/more.svg" alt="More">
            </button>
            <nav id="dropup">
                <div id="about-button" class="link hover clickable">Über</div>
                <div>Lang buttons lol</div>
                <div id="help-button" class="link hover clickable">Hilfe</div>
            </nav>
        </span>
    </footer>
</body>

</html>