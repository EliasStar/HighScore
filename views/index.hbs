<html lang="" theme="light">

<head>
    <title>HighScore</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/css/style.css" type="text/css">
    <script src="/public/js/client.js" defer></script>
    <script src="/public/js/path.js" defer></script>
    <script src="/public/js/theme.js" defer></script>
    <script src="/public/js/dropup.js" defer></script>
</head>

<body>
    <main>
        <div id="loading-container">
            <div class="container">
                <p id="path">Laden...</p>
            </div>
            <div class="container">
                <header>Laden...</header>
                <div class="content">
                    <span class="spin icon icon-refresh"></span>
                </div>
            </div>
        </div>
        <div id="error-container">
            <div class="container">
                <p id="path">Übersicht / Fehler</p>
            </div>
            <div class="container">
                <header>Fehler</header>
                <div class="content">
                    <div class="error-message">
                        <p class="error-title"></p>
                        <p class="error-description"></p>
                    </div>
                </div>
            </div>
        </div>
        {{> (lookup . 'currentContainer') }}
    </main>
    <footer id="footer">
        <span id="logo" class="clickable hover">
            <img src="/public/img/logo.jpg" alt="Dachsberg Logo" />
            <h1>HighScore</h1>
        </span>


        <span id="options">
            <span>
                {{#if teacher}}
                <label for="gender">Geschlecht:</label>
                <select id="gender">
                    <option value="A" selected>Alle</option>
                    <option value="W">Mädchen</option>
                    <option value="M">Buben</option>
                </select>

                <span class="right">
                    <label for="class">Klasse:</label>
                    <select id="class">
                        <option value="All" selected>Alle</option>
                        {{#each classes}}
                        <option value="{{this}}">{{this}}</option>
                        {{/each}}
                    </select>
                </span>
                {{/if}}
            </span>
        </span>

        <span id="buttons">
            {{#if teacher}}
            <button id="add-button" class="btn clickable" type="button">
                <img src="/public/img/plus.svg" alt="Add">
            </button>
            {{/if}}
            <button id="theme-button" class="btn clickable" type="button">
                <img id="icon-dark" src="/public/img/dark.svg" alt="Switch Theme">
                <img id="icon-light" src="/public/img/light.svg" alt="Switch Theme">
            </button>
            <button id="dropup-button" class="btn clickable" type="button">
                <img src="/public/img/more.svg" alt="More">
            </button>
            <nav id="dropup">
                <div class="link hover clickable">Über</div>
                <div>Lang buttons lol</div>
                <div class="link hover clickable">Hilfe</div>
            </nav>
        </span>
    </footer>
</body>

</html>