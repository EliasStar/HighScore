<div>
    <div class="container">
        <p id="path">Übersicht</p>
    </div>
    <div class="container">
        <header>Übersicht</header>
        <div class="content">
            <table class="table">
                <thead>
                    <tr>
                        <th>Sport</th>
                        <th>Bestes Ergebnis</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each sports}}
                    <tr>
                        <td>{{this.name}}</td>
                        <td>{{this.score}}</td>
                        <td><span class="btn-icon icon-circle-arrow-right"></span></td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>