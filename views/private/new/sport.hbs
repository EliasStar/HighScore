<div id="current-container">
    <div class="container">
        <p id="path"><span class="get-button clickable link hover" data-location="/private/overview">Übersicht</span> /
            Neuer Sport</p>
    </div>
    <div class="container">
        <header>Sport hinzufügen</header>
        <div class="content">
            <div class="error-message">
                <p class="error-title"></p>
                <p class="error-description"></p>
            </div>
            <div id="new-sport" data-csrf-token="{{csrfToken}}">
                <label for="name">Name:</label>
                <input class="ui input" type="text" name="name" placeholder="60m Sprint" required>
                <label for="unitName">Einheit:</label>
                <input class="ui input" type="text" name="unitName" placeholder="Zeit" required>
                <label for="unit">Maßeinheit (Abkürzung):</label>
                <input class="ui input" type="text" name="unit" placeholder="s">
            </div>
            <button class="post-button ui btn btn-accent clickable" data-location="/private/new/sport"
                data-formular="new-sport">Speichern</button>
            <button class="get-button ui btn btn-normal clickable" data-location="/private/overview">Abbrechen</button>
        </div>
    </div>
</div>