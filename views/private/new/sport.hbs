<div id="current-container">
    <div class="container">
        <p id="path">
            <span class="get-button clickable link hover" data-location="/private/overview">Übersicht</span> / Neuer Sport
        </p>
    </div>
    <div class="container">
        <header>Sport hinzufügen</header>
        <div class="content">
            <div class="error-message">
                <p class="error-title"></p>
                <p class="error-description"></p>
            </div>

            <div id="new-sport" class="formular" data-csrf-token="{{csrfToken}}">
                <label for="name">Name*:</label>
                <input class="ui input" type="text" name="name" placeholder="60m Sprint" required>

                <label for="unit">Maßeinheit*:</label>
                <input class="ui input" type="text" name="unit" placeholder="Zeit" required>

                <label for="unitSymbol">Einheitenkürzel :</label>
                <input class="ui input" type="text" name="unitSymbol" placeholder="s">
            </div>
        </div>
        <footer>
            <div class="formular-buttons">
                <button class="get-button ui btn btn-normal clickable" data-location="back">Abbrechen</button>
                <button class="post-button ui btn btn-accent clickable" data-location="/private/new/sport" data-formular="new-sport">Speichern</button>
            </div>
        </footer>
    </div>
</div>