<div id="current-container" data-location="/private/overview">
    <div class="container">
        <p id="path">Übersicht</p>
    </div>
    <div class="container">
        <header>Übersicht</header>
        <div class="content">
            <table class="table">
                <thead>
                    <tr>
                        <th>Sport</th>
                        <th>Bestes Ergebnis</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each sports}}
                    <tr>
                        <td>{{name}}</td>
                        <td>
                            {{score}}{{unitSymbol}}
                            {{#if student}}
                            ({{student}})
                            {{/if}}
                        </td>
                        <td>
                            <span class="get-button clickable btn-icon icon icon-circle-arrow-right"
                                data-location="/private/sport/{{id}}"></span>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>