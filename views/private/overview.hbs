<div id="current-container">
    <meta name="csrf-token" content="{{csrfToken}}">
    <div class="container">
        <p id="path">Übersicht</p>
    </div>
    <div class="container">
        <header>Übersicht</header>
        <div class="content">
            <table class="table">
                <thead>
                    <tr>
                        <th>Sport</th>
                        <th>Bestes Ergebnis</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each sports}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{score}} {{unitSymbol}}</td>
                        <td><span id="sport-{{id}}"
                                class="next-button clickable btn-icon icon icon-circle-arrow-right"></span>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <script src="/public/js/overview.js"></script>
</div>