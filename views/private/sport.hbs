<div>
    <div class="container">
        <p id="path">
            <span id="path-overview" class="path-button clickable link hover">Übersicht</span> / {{sport.name}}
        </p>
    </div>
    <div class="container">
        <header>{{sport.name}}</header>
        <div class="content">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>{{sport.unitName}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each entries}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{score}}{{@root.sport.unit}}</td>
                        <td>
                            <span id="sport-{{@root.sport.id}}-student-{{id}}"
                                class="next-button clickable btn-icon icon icon-circle-arrow-right"></span>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>