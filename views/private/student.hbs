<div id="current-container">
    <meta name="csrf-token" content="{{csrfToken}}">
    <div class="container">
        <p id="path">
            <span id="path-overview" class="path-button clickable link hover">Übersicht</span> / {{sport.name}}
        </p>
    </div>
    <div class="container">
        <header>{{sport.name}}</header>
        <div class="content">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{sport.unit}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each scores}}
                    <tr>
                        <td>{{this}} {{@root.sport.unitSymbol}}</td>
                        <td></td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <script src="js/sport.js"></script>
</div>